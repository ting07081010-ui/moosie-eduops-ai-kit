# Provider: claude or openai.
# Leave unset to use Claude when ANTHROPIC_API_KEY is set, otherwise OpenAI.
AI_PROVIDER=

# Claude (Anthropic). Default model is current Sonnet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a cheaper Claude model for the parent-message risk check only.
ANTHROPIC_RISK_MODEL=

# OpenAI. Used when AI_PROVIDER=openai, or when ANTHROPIC_API_KEY is unset.
OPENAI_API_KEY=sk-your-key-here
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
MODEL=gpt-4o-mini
