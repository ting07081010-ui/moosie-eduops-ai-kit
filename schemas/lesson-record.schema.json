{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LessonRecord",
  "type": "object",
  "required": ["studentCode", "date", "topic", "performance"],
  "properties": {
    "studentCode": {
      "type": "string",
      "pattern": "^S-[0-9]{3}$",
      "description": "Opaque student identifier (never a real name)"
    },
    "classCode": {
      "type": "string",
      "description": "Class identifier, e.g. M-ESL-G3-A"
    },
    "teacherCode": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$",
      "description": "Teacher identifier"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Lesson date in YYYY-MM-DD format"
    },
    "lessonType": {
      "type": "string",
      "enum": ["reading", "speaking", "writing", "grammar", "project", "listening", "vocab"],
      "description": "Primary skill focus of this lesson"
    },
    "topic": {
      "type": "string",
      "description": "What was taught in this lesson"
    },
    "learningObjective": {
      "type": "string",
      "description": "What the student should achieve by end of this lesson cycle"
    },
    "cefrTarget": {
      "type": "string",
      "enum": ["Pre-A1", "A1", "A2", "B1", "B2", "C1"],
      "description": "CEFR level target for this student"
    },
    "skills": {
      "type": "object",
      "properties": {
        "speaking": { "type": "integer", "minimum": 1, "maximum": 5 },
        "listening": { "type": "integer", "minimum": 1, "maximum": 5 },
        "reading": { "type": "integer", "minimum": 1, "maximum": 5 },
        "writing": { "type": "integer", "minimum": 1, "maximum": 5 },
        "grammar": { "type": "integer", "minimum": 1, "maximum": 5 },
        "participation": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "description": "Skill ratings (1-5) observed in this lesson"
    },
    "performance": {
      "type": "string",
      "description": "Objective observation of student performance"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific observable moments from the lesson"
    },
    "homeworkStatus": {
      "type": "string",
      "enum": ["done", "partial", "missing"],
      "description": "Whether homework was completed"
    },
    "parentAction": {
      "type": "string",
      "description": "One specific action the parent can do at home this week"
    },
    "teacherNextStep": {
      "type": "string",
      "description": "What the teacher will do next lesson"
    },
    "retentionSignal": {
      "type": "string",
      "enum": ["green", "yellow", "red"],
      "description": "Retention risk: green=stable, yellow=watch, red=at-risk"
    },
    "observations": {
      "type": "string",
      "description": "Additional teacher notes"
    },
    "followUps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Action items for next lesson or follow-up"
    },
    "attendance": {
      "type": "string",
      "enum": ["present", "absent", "late"],
      "description": "Student attendance status"
    }
  },
  "additionalProperties": false
}
