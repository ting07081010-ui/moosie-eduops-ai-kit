{
  "name": "moosie-eduops-ai-kit",
  "version": "0.3.0",
  "description": "Open-source AI operations toolkit for small education providers",
  "type": "module",
  "engines": {
    "node": "^20.12.0 || >=21.7.0"
  },
  "scripts": {
    "cli": "node --import ./scripts/load-env.mjs src/adapters/cli-adapter.mjs",
    "demo": "node --import ./scripts/load-env.mjs scripts/demo.mjs",
    "demo:moosi-say": "node --import ./scripts/load-env.mjs examples/moosi-say-demo/server.mjs",
    "line": "node --import ./scripts/load-env.mjs src/adapters/line-webhook-server.mjs",
    "line:quick-reply": "node --import ./scripts/load-env.mjs src/adapters/line-webhook-server.mjs",
    "line:demo": "node --import ./scripts/load-env.mjs examples/line-webhook-demo/server.mjs",
    "line:slash-demo": "node --import ./scripts/load-env.mjs examples/line-webhook-demo/server.mjs",
    "eval": "node --import ./scripts/load-env.mjs evals/run-evals.mjs --live",
    "eval:structural": "node --import ./scripts/load-env.mjs evals/run-evals.mjs",
    "test": "node --test",
    "scan": "node scripts/pii-scanner.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "education",
    "ai",
    "llm",
    "prompt-engineering",
    "line-bot",
    "privacy",
    "edtech"
  ],
  "author": "Moosie Edu",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "express": "^4.19.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
